APP_NAME="MegaPalmeira"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Maceio

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# hosts internos da rede do Docker (mysql/redis/reverb/ssr são nomes de serviço)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=megapalmeira
DB_USERNAME=megapalmeira
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="bolao@megapalmeira.test"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb — em produção, gere id/key/secret próprios
REVERB_APP_ID=746392
REVERB_APP_KEY=megapalmeira-local-key
REVERB_APP_SECRET=megapalmeira-local-secret
# host/porta que o BACKEND usa para publicar (rede interna do Docker)
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# o ranking completo viaja no payload do sorteio: limites acima do default
REVERB_APP_MAX_MESSAGE_SIZE=1000000
REVERB_MAX_REQUEST_SIZE=1000000

VITE_APP_NAME="${APP_NAME}"
# host/porta que o NAVEGADOR usa (local: 8081 externo -> 8080 no container)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

INERTIA_SSR_URL=http://ssr:13714

# Mercado Pago — use credenciais TEST-... no sandbox
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=

BOLAO_ADMIN_EMAIL=admin@example.com
